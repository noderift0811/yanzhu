# ===== 言筑 YanZhu 后端配置模板 =====
# 复制为 .env 后填写；.env 不入库

# ===== 运行模式 =====
# framework = 框架期（LLM 密钥留空即自动走 MockAdapter，全流程可跑）
# dev / production = 接线期
APP_ENV=framework

# ===== JWT =====
# 生产环境必须换成随机串：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=please-change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ===== 数据库（相对路径以 backend/ 为根）=====
DB_PATH=data/yanzhu.db

# ===== 工程师 AI：人设与页面规格生成，质量优先，调用频次低 =====
ENGINEER_LLM_ADAPTER=deepseek
ENGINEER_LLM_BASE_URL=https://api.deepseek.com/v1
ENGINEER_LLM_API_KEY=
ENGINEER_LLM_MODEL=deepseek-v4-pro

# ===== 人格 AI：聊天运行时，高频调用，快且便宜 =====
PERSONA_LLM_ADAPTER=deepseek
PERSONA_LLM_BASE_URL=https://api.deepseek.com/v1
PERSONA_LLM_API_KEY=
PERSONA_LLM_MODEL=deepseek-flash

# ===== 配额 =====
QUOTA_GEN_DAILY=20
QUOTA_CHAT_DAILY=100
CHAT_HISTORY_WINDOW=20

# ===== 演示 / 评审账号 =====
# 启动期幂等播种，评委绕开注册限流直接登录；上线想关掉设 false（登录页填充入口随之隐藏）
DEMO_USER_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=yanzhu2026
DEMO_QUOTA_GEN=200
DEMO_QUOTA_CHAT=2000
